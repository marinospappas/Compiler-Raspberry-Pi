program testdelay

var mytime: string(30)
var time_s: intarray(2)
var UNIT_SEC @external:int
var secs: int, nanosecs: int
var now: bytearray(10)

fun getlocaltimestr() @external:string
fun sleep(duration: int, units: int) @external:void
fun clock_gettime(clock: int, time_spec: intarray) @external:void

/* main          */
main {
    while (true) {
        mytime = getlocaltimestr()
	    print mytime
	    clock_gettime(0, time_s)
	    secs = time_s\0\
	    nanosecs = time_s\1\
	    println "secs: ", secs, " nano_secs: ", nanosecs
	    sleep(1, UNIT_SEC)
    }
}

endprogram
