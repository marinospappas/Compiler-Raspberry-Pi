  -- Various time related functions (local time)
  -- Recuires libc
  -- Marinos Pappas
 */
library time

var CLOCK_REALTIME: int = 0
var tv: intarray(2)

var tm: bytearray(80)
var time_now: int

fun gettime() @external:intpair
fun ctime(time_t: memptr) @external:string
fun localtime_r(timep: memptr, result: bytearray) @external:void
fun sleep_nanosec(sec: int, nanosec: int) @external:void

//
// get local time
// sets local time in a byte array parameter
// format h:m:s d.m.y
//
fun getlocaltime(cur_time: bytearray) @global:void {
    tv$ = gettime()
    time_now = tv\0\
    localtime_r(addr(time_now), tm)
    cur_time\0\ = tm\8\
    cur_time\1\ = tm\4\
    cur_time\2\ = tm\0\
    cur_time\3\ = tm\12\
    cur_time\4\ = tm\16\ + 1
    cur_time\5\ = tm\20\
    return
}

//
// getlocaltimestr
// returns the local time as string
//
fun getlocaltimestr() @global:string {
    tv$ = gettime()
    time_now = tv\0\
    return ctime(addr(time_now))
}

// wait until the second changes
fun wait_until_sec_change() @global:void {
    var nanosecs: int
    var start_usec: int
    var usec_now: int
    var usec_difference: int

    nanosecs = 10    // the 1% of the duration converted to nanosec
    tv$ = gettime()
    start_usec = tv\1\ / 1000
    while (1) {
    tv$ = gettime()
        usec_now = tv\1\ / 1000
        usec_difference = usec_now - start_usec
        if (usec_difference < 0) {
		    usec_difference = usec_difference + 1000000
		}
	    if (usec_difference >= 0) {
            return
        }
        sleep_nanosec(0, nanosecs)
    }
}

endlibrary