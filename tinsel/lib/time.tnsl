library time

var CLOCK_REALTIME: int = 0

var UNIT_SEC @global:int = 2,
    UNIT_MILLISEC @global:int = 1,
    UNIT_MICROSEC @global:int = 0

var tm: bytearray(80)
var time_epoch: int

fun sleep_nanosec(sleep_sec: int, sleep_nanosec: int) @external:void
fun clock_gettime(clock: int, time_now: intarray) @external:void

//
// sleep function
// accepts: duration of sleep
//          units: 1=millisec, 0=microsec, or sec (default)
fun sleep(duration: int, unit: int) @global:void {
    if (duration < 0) { return }
    if (unit == UNIT_MILLISEC) {
        if (duration > 999) {
            sleep_nanosec(duration / 1000, 0)
            sleep_nanosec(0, (duration % 1000) * 1000000)
        }
        else {
            sleep_nanosec(0, duration * 1000000)
        }
        return
    }
    if (unit == UNIT_MICROSEC) {
        if (duration > 999999) {
            sleep_nanosec(duration / 1000000, 0)
            sleep_nanosec(0, (duration % 1000000) * 1000)
        }
        else {
            sleep_nanosec(0, duration * 1000)
        }
        return
    }
    sleep_nanosec(duration, 0)
    return
}

//
// gettime function
// accepts: pointer to struct timespec
fun gettime__(time_now: intarray) @global:void {
    clock_gettime(CLOCK_REALTIME, time_now)
    return
}

endlibrary